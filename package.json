{
  "name": "quiet-choir",
  "version": "0.0.0",
  "description": "Harness-agnostic dynamic workflows for agents.",
  "keywords": [
    "agents",
    "orchestration",
    "workflow",
    "workflow-engine"
  ],
  "homepage": "https://github.com/plx/quiet-choir#readme",
  "bugs": {
    "url": "https://github.com/plx/quiet-choir/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plx/quiet-choir.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "quiet-choir": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json",
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "harness-kit": [
        "./dist/harness-kit.d.ts"
      ],
      "decision": [
        "./dist/integrations/decision.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./harness-kit": {
      "types": "./dist/harness-kit.d.ts",
      "import": "./dist/harness-kit.js",
      "default": "./dist/harness-kit.js"
    },
    "./decision": {
      "types": "./dist/integrations/decision.d.ts",
      "import": "./dist/integrations/decision.js",
      "default": "./dist/integrations/decision.js"
    }
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run skills:check && npm run test:coverage && npm run build && npm run comparisons:check && npm run test:cli && npm run docs:check && npm run package:check",
    "ci": "npm run check",
    "clean": "rimraf coverage dist docs/api oclif.manifest.json",
    "cli": "node ./bin/run.js",
    "cli:dev": "tsx ./bin/dev.js",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "docs": "rimraf docs/api && typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "manifest": "oclif manifest",
    "package:check": "attw --pack . --ignore-rules cjs-resolves-to-esm && publint",
    "postpack": "rimraf oclif.manifest.json",
    "prepack": "npm run build && npm run manifest",
    "test": "vitest run",
    "test:cli": "node ./test/cli-smoke.mjs && node ./test/policy-cli-smoke.mjs && node ./test/replay-cli-smoke.mjs && node ./test/settled-cli-smoke.mjs && node ./test/fan-out-cli-smoke.mjs && node ./test/scoped-ids-cli-smoke.mjs && node ./test/profiles-cli-smoke.mjs && node ./test/agent-limits-cli-smoke.mjs && node ./test/process-lifecycle-cli-smoke.mjs && node ./test/scriptable-cli-smoke.mjs && node ./test/observability-cli-smoke.mjs && node ./test/rehearsal-cli-smoke.mjs && node ./test/schema-values-cli-smoke.mjs && node ./test/skills-cli-smoke.mjs && node ./test/questions-cli-smoke.mjs && node ./test/storage-cli-smoke.mjs && node ./test/waits-cli-smoke.mjs && node ./test/exec-files-cli-smoke.mjs && node ./test/worktrees-cli-smoke.mjs && node ./test/harness-isolation-cli-smoke.mjs && node ./test/agent-stream-cli-smoke.mjs && node ./test/usage-cli-smoke.mjs && node ./test/children-cli-smoke.mjs && node ./test/harness-registry-cli-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json",
    "comparisons:check": "tsc -p comparisons/batches/01-direct-ports/tsconfig.json && node --import tsx comparisons/scripts/verify-ports.mjs --check",
    "test:contract": "node ./test/harness-contract.mjs",
    "test:contract:isolation": "node ./test/harness-isolation-contract.mjs",
    "skills:check": "node scripts/check-skills.mjs && node --test test/skills-check.test.mjs",
    "test:storage-benchmark": "node ./test/storage-benchmark.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "oclif": "4.23.30",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "typedoc": "0.28.20",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@oclif/core": "4.13.3",
    "@types/node": "22.13.17",
    "smol-toml": "1.9.0",
    "tsx": "4.23.11",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "zod": "4.5.4"
  },
  "oclif": {
    "bin": "quiet-choir",
    "commands": "./dist/commands",
    "dirname": "quiet-choir",
    "topicSeparator": " ",
    "topics": {
      "configuration": {
        "description": "Inspect and manage quiet-choir configuration"
      },
      "info": {
        "description": "Show information about quiet-choir"
      },
      "workflow": {
        "description": "Execute and inspect workflows"
      }
    }
  }
}
